# Copy this to .env and fill in real values. Never commit .env.

# --- Supabase (get these from your project's Settings > API page) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# service_role key — server-side only, never expose to mobile/web clients
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- App ---
PORT=4000
NODE_ENV=development

# --- Trust & Safety Engine defaults (Decision Addendum, pending sponsor sign-off) ---
GEOFENCE_RADIUS_METERS=150
ROUTE_DEVIATION_METERS=400
ROUTE_DEVIATION_MINUTES=3
STATIONARY_FLAG_MINUTES=5

# --- Payments (Paystack sandbox keys, get from dashboard.paystack.com) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# --- Matching ---
INITIAL_MATCH_RADIUS_METERS=4828
MAX_CONCURRENT_ERRANDS_PER_RUNNER=3

# --- Commission ---
PLATFORM_COMMISSION_RATE=0.15
